# Copy this file to .env and fill in your own key.
# Never commit the real .env file to git.

ANTHROPIC_API_KEY=sk-ant-...your-key-here...
TYPESAFE_AI_APY_KEY=...
GEMINI_API_KEY=...
DEEPSEEK_API_KEY=...

# Optional: which voice speaks. "chatterbox" uses the Chatterbox voice from
# experimental/speech-framework (first: pip install -r
# experimental/speech-framework/requirements.txt; engines and voice clips are
# chosen in its config.yaml). Leave unset, or "edge", for Microsoft Edge TTS.
# Edge TTS is also used whenever Chatterbox cannot load or cannot say
# something, and the program says so when that happens.
# SB01_VOICE=chatterbox
#
# Chatterbox runs on the processor (cpu) unless told otherwise: its models need
# about 5.7 GB of graphics memory and the gesture server uses the same card.
# On a processor it is slow: the robot is silent for several seconds (longer
# for long replies) while each reply is synthesized. "cuda" is used only if
# SB01_CHATTERBOX_GPU_GB (default 7) of graphics memory is free; otherwise it
# stays on the processor and says so.
# SB01_CHATTERBOX_DEVICE=cpu
# Leave SB01_CHATTERBOX_GPU_GB unset to use the built-in requirements (7 GB for
# both engines, 4 GB for the English engine alone). Setting it replaces them:
# with it set to 7, the English engine alone would also need 7 GB.
# SB01_CHATTERBOX_GPU_GB=7
#
# Faster English on a small card: with cuda, name the engines that may use the
# card. "nano" (English) is used only if 4 GB is free (2.5 GB for the engine,
# 1.5 GB kept for the gesture server), which fits a 6 GB card with the gesture
# server on it; otherwise it runs on the processor and says why. Spanish and
# Chinese stay on the processor.
# SB01_CHATTERBOX_DEVICE=cuda
# SB01_CHATTERBOX_GPU_ENGINES=nano

# Optional: co-speech arm gestures. Run scripts/setup_gestures.sh, start
# scripts/gesture_server.py, then set this the same way as the API key.
# Leave it unset for no arm motion.
# SB01_GESTURE_URL=http://127.0.0.1:8765

# Optional, needs the gesture setting above: fixed poses between speech.
# "thinking": right hand under the chin, left hand toward the right elbow, while a
# reply is worked out.
# Leave it unset for speech gestures only.
# SB01_GESTURE_POSES=thinking

# Optional, needs the gesture setting above: teaching gestures. Claude may mark a
# word in its reply and an arm gesture (yes, pointing, one hand / other hand,
# small, big, any questions) arrives on that word. Leave unset for none.
# SB01_GESTURE_CUES=1
# SB01_BOARD_SIDE=left      # where the board or screen is, for pointing: left or right
