# Copy this file to .env and fill in your own key.
# Never commit the real .env file to git.

ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Optional: co-speech arm gestures. Run scripts/setup_gestures.sh, start
# scripts/gesture_server.py, then set this the same way as the API key.
# Leave it unset for no arm motion.
# SB01_GESTURE_URL=http://127.0.0.1:8765
